<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Lets hands-free commands open apps from the background; optional, a tap on a notification works without it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Reminders are real alarms on this phone: they fire on time even with no computer and no network. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Asked for only when the operator uses the feature; every one can be refused. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Voice timers and alarms are handed to the phone's Clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Android 11+ hides other apps from us unless we declare what we talk to. Without these, speech
         recognition and spoken replies cannot find their services and fail. -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <!-- Without these Android hides every other app from us, so "open Apple Music" finds nothing. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="google.navigation" /></intent>
        <intent><action android:name="android.intent.action.WEB_SEARCH" /></intent>
        <intent><action android:name="android.intent.action.MEDIA_SEARCH" /></intent>
        <intent><action android:name="android.media.browse.MediaBrowserService" /></intent>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent><action android:name="android.media.action.STILL_IMAGE_CAMERA" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
    </queries>

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_ultron"
        android:label="ULTRON"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ultron"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ultron://pair?... (the desktop's QR code opened by the camera): only ever offered to the
                 user to confirm, never applied by itself. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ultron" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Opened only from our own notification (not exported): the confirmation before any call. -->
        <activity
            android:name=".ui.CallConfirmActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="false" />

        <service
            android:name=".service.PushService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one connection to the user's own ULTRON server on their home network so reminders and call confirmations arrive immediately." />
        </service>

        <service
            android:name=".service.HandsFreeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The Cancel button on the "Calling ..." countdown notification. Our own notification only. -->
        <receiver
            android:name=".service.CallCancelReceiver"
            android:exported="false" />

        <!-- Fires a reminder at its time (set with AlarmManager by LocalReminders). Our own alarms only. -->
        <receiver
            android:name=".service.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
