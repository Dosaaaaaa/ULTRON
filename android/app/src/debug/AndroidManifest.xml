<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug builds only: allow the emulator's alias for the host machine over http. -->
    <application android:networkSecurityConfig="@xml/network_security_debug" tools:replace="android:networkSecurityConfig">
        <!-- DEBUG BUILDS ONLY: lets adb feed a sentence to the voice router so the whole command path can be
             tested on an emulator without a microphone. Not part of the release build. -->
        <receiver android:name="com.ultron.assistant.DebugCommandReceiver" android:exported="true" />
    </application>
</manifest>
