# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# --- Required -------------------------------------------------------------
# Bearer token clients must send. >= 24 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ULTRON_API_TOKEN=

# --- Server ---------------------------------------------------------------
ULTRON_HOST=127.0.0.1
ULTRON_PORT=8000
ULTRON_LOG_LEVEL=INFO
ULTRON_RATE_LIMIT_PER_MINUTE=30
# Only honoured on a loopback host; the server refuses to start otherwise.
ULTRON_AUTH_DISABLED=false

# --- Persistence ----------------------------------------------------------
# SQLite for Phase 1. PostgreSQL URL form (untested in Phase 1):
#   postgresql+asyncpg://user:pass@localhost:5432/ultron   (needs the asyncpg package)
ULTRON_DATABASE_URL=sqlite+aiosqlite:///./data/ultron.db
ULTRON_AUTO_MIGRATE=true

# --- Routing --------------------------------------------------------------
# auto | cloud_first | local_first | local_only
ULTRON_ROUTING_POLICY=auto
# Master privacy switch. false => nothing is ever sent to a cloud provider.
ULTRON_ALLOW_CLOUD=true

# --- Cloud model (any OpenAI-compatible /chat/completions endpoint) --------
# Cloud is considered configured only when key AND model are set. Put real values in
# backend/.env (git-ignored), NEVER in this file.
#
# Tested live (2026-11-10): Groq free tier with qwen/qwen3.8-27b - first token ~0.3-0.5 s, concise,
# no hidden reasoning. Its free-tier limits for this key: 1,000 requests/day, 8,000 tokens/MINUTE and
# **200,000 tokens/DAY (rolling)**. The daily token cap is the one that binds: one ULTRON request is
# ~1,000-1,300 tokens (mostly the personality prompt), so about 150-200 requests per day, then HTTP 429
# and the router falls back to the local model (honestly, with a notice).
# openai/gpt-oss-120b is stronger but spends the 300-token voice budget on hidden reasoning (empty replies).
ULTRON_CLOUD_PROVIDER_NAME=groq
ULTRON_CLOUD_BASE_URL=https://api.groq.com/openai/v1
ULTRON_CLOUD_API_KEY=
ULTRON_CLOUD_MODEL=qwen/qwen3.8-27b
# Gemini instead: base https://generativelanguage.googleapis.com/v1beta/openai , a key starting AIza...
ULTRON_CLOUD_TIMEOUT_S=60
# Budget limiter (app/models/budget.py): stay under the quota instead of paying for 429s.
# Groq's limits belong to your ORGANISATION (account), not to an API key: extra keys share one bucket.
# Requests that would not fit are answered by the local model without calling the cloud. 0 = unknown.
ULTRON_CLOUD_LIMIT_TOKENS_PER_DAY=200000
ULTRON_CLOUD_LIMIT_TOKENS_PER_MINUTE=8000
ULTRON_CLOUD_LIMIT_REQUESTS_PER_DAY=1000
ULTRON_CLOUD_BUDGET_SAFETY=0.9

# --- Local model (Ollama) -------------------------------------------------
ULTRON_OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen3:4b-instruct = Qwen3-4B-Instruct-2507 (non-thinking). Plain qwen3:4b is thinking-only: slow.
ULTRON_OLLAMA_MODEL=qwen3:4b-instruct
ULTRON_OLLAMA_TIMEOUT_S=120
# false for instruct/non-thinking models; true only for the thinking variant (qwen3:4b)
ULTRON_OLLAMA_THINK=false

# --- Conversation ---------------------------------------------------------
# 3 = tuned for qwen3:4b-instruct (short, rule-bound, resists style overrides). 1, 2 = older.
# --- long-term memory (Phase 4; docs/PHASE_4_MEMORY.md) ---
# Embeddings come from the LOCAL Ollama (run once: `ollama pull nomic-embed-text`); memory text is never
# sent to a cloud service to be embedded. The database may be SQLite or PostgreSQL + pgvector.
ULTRON_MEMORY_ENABLED=true
ULTRON_EMBEDDING_MODEL=nomic-embed-text
# Never place any memory text in a cloud model's prompt (local_only memories are never sent regardless):
ULTRON_MEMORY_ALLOW_CLOUD=true
# Minimum similarity for a memory to be used. Stricter for the cloud because that text leaves the device.
ULTRON_MEMORY_MIN_SIMILARITY=0.55
ULTRON_MEMORY_MIN_SIMILARITY_CLOUD=0.60
# Episodic memories expire after this many days (0 = keep until deleted). Others are kept until deleted.
ULTRON_MEMORY_EPISODIC_RETENTION_DAYS=90
# --- reasoning pass (docs/INTELLIGENCE.md) ---
# For problem-like questions (arithmetic, dates, logic, code tracing, counting) the model first solves the
# problem privately, step by step, then writes the reply with that working. It follows the same routing and
# privacy rules as any reply (a local_only chat is solved on this machine) and costs one extra model call.
ULTRON_REASONING=auto            # auto | off
ULTRON_REASONING_VOICE=true      # also for spoken replies (adds several seconds on those questions)
ULTRON_REASONING_MAX_TOKENS=800

# --- web search (OFF unless you configure a provider; docs/INTELLIGENCE.md) ---
# WHAT LEAVES THIS MACHINE: only the question you just asked (shortened to 200 characters), sent to the search
# provider, and only for recent-sounding questions or "search for ...". Never in a local_only conversation,
# never when the message looks like it holds a secret, and never when ULTRON_ALLOW_CLOUD=false. Each use is
# reported in the reply (query, provider, sources).
# ULTRON_WEB_SEARCH_PROVIDER=brave          # none | brave | searxng
# ULTRON_WEB_SEARCH_API_KEY=                # Brave Search API key (put it in backend/.env, never here)
# ULTRON_WEB_SEARCH_URL=http://127.0.0.1:8888   # base URL of a SearXNG instance you run yourself
# ULTRON_WEB_SEARCH_MAX_PER_DAY=50
# ULTRON_WEB_SEARCH_AUTO=true               # false = only an explicit "search for ..."
ULTRON_PERSONALITY_VERSION=4
ULTRON_MAX_CONTEXT_MESSAGES=20
ULTRON_MAX_OUTPUT_TOKENS=2048
ULTRON_TEMPERATURE=0.6

# --- Voice client (desktop/voice) - read by `python -m ultron_voice` ----------
# The token is the same ULTRON_API_TOKEN as above. Everything below is optional.
# ULTRON_VOICE_BACKEND_URL=ws://127.0.0.1:8000/v1/ws/chat   # use wss:// if not on loopback
# ULTRON_VOICE_MODELS_DIR=~/.cache/ultron/models
# ULTRON_VOICE_STT_THREADS=8        # measured fastest on the reference 6-core/12-thread laptop
# ULTRON_VOICE_TTS_THREADS=6
# ULTRON_VOICE_TTS_VOICE=bm_george  # or a blend: bm_george:0.7,am_onyx:0.3
# ULTRON_VOICE_TTS_SPEED=0.92
# ULTRON_VOICE_TTS_METAL=0.15       # 0 = none, 1 = strongly robotic
# ULTRON_VOICE_MIC=                 # PipeWire node name (python -m ultron_voice devices)
# ULTRON_VOICE_SPEAKER=

# --- Desktop app (desktop/app) and device agent (desktop/agent) ------------------
# The app uses the same ULTRON_API_TOKEN (environment, or backend/.env during development).
# Approved folders and allowlisted apps are NOT configured here: use `ultron-agent roots|apps`,
# which writes ~/.config/ultron/agent.json (mode 0600). Never put secrets in that file either.
# ULTRON_BACKEND_URL=http://127.0.0.1:8000        # https:// if not on loopback
# ULTRON_AGENT_RUNTIME_DIR=                       # default: $XDG_RUNTIME_DIR/ultron
