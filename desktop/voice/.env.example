# desktop/voice/.env (git-ignored; copy this file to .env). Never commit real values.
#
# Optional cloud voice (Fish Audio). OFF unless ULTRON_VOICE_TTS_PROVIDER=fish.
# When on, the TEXT of ULTRON's spoken replies is sent to Fish Audio. What you say is never sent.
# Conversations marked local-only (or locked to local) are always spoken by the local voice.
# ULTRON_VOICE_TTS_PROVIDER=fish
# ULTRON_VOICE_FISH_API_KEY=            # from https://fish.audio/app/developers/get-started/
# ULTRON_VOICE_FISH_VOICE_ID=           # the model id from the voice page URL (/m/<id>)
# ULTRON_VOICE_FISH_MODEL=s2.1-pro-free # the free tier is small (reported by the operator: about 8K tokens a month),
#                                        # so it is not suitable as an everyday voice. Omitting a model is billed.

# The finished local voice (these are the defaults; set a value only to change it).
# Voice: Kokoro bm_lewis, pitch 0.80, bass 0.8, a metallic resonance and a light 90 Hz ring.
# ULTRON_VOICE_TTS_VOICE=bm_lewis
# ULTRON_VOICE_TTS_PITCH=0.80      # lower = deeper (0.5..1.5; 1.0 = as the model makes it)
# ULTRON_VOICE_TTS_BODY=0.8        # bass weight 0..1
# ULTRON_VOICE_TTS_RESONANCE=1.0   # metallic ring 0..1 (0 = off)
# ULTRON_VOICE_TTS_RING=0.10       # robotic 90 Hz buzz 0..1 (0 = off); 0.28 is clearly audible
# Gaps and pace. Set all three to 0 for continuous speech.
# ULTRON_VOICE_TTS_PAUSE=0.28          # seconds of silence after a comma (colon x1.4, sentence x1.9, ellipsis x2.7)
# ULTRON_VOICE_TTS_SENTENCE_GAP=0.5    # seconds between spoken sentences
# ULTRON_VOICE_TTS_DELIVERY=1.0        # 0..1 pace variation: short phrases slower, closing phrase heavier
